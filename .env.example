ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_pass
ADMIN_JWT_SECRET=jwt_sec
POSTGRES_URL=your_vercel_postgres_connection_string_here

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=test@test.com
SMTP_PASSWORD=smtp_pass
SMTP_FROM_EMAIL="Local Test <test@test.com>"

# nodemailer mails
ADMIN_EMAIL=test@admintest.com
EMAIL_USER=test@test.com

# Marketing Tusk Sanity
NEXT_PUBLIC_SANITY_DATASET=development
NEXT_PUBLIC_SANITY_PROJECT_ID=sanity_id
SANITY_API_READ_TOKEN=sanity_token
SANITY_PREVIEW_SECRET=sanity_secret_password

# Google OAuth2 — used by nodemailer (Gmail) to send notification emails
CLIENT_ID=clientId.apps.googleusercontent.com
CLIENT_SECRET=client_sec
REFRESH_TOKEN=refresh_token

# Google service account — used to read/write Google Sheets.
# Share the spreadsheet with GOOGLE_SERVICE_ACCOUNT_EMAIL (Editor access).
# The private key is stored with literal \n escapes; the app converts them.
GOOGLE_SERVICE_ACCOUNT_EMAIL=sheet-saver@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk...-----END PRIVATE KEY-----\n"

SPREADSHEET_ID=your_spreadsheet_id

# Optional: tab used for newsletter signups (created automatically if missing)
NEWSLETTER_SHEET_TAB=Newsletter

NEXT_PUBLIC_SITE_URL=http://localhost:3000

GOOGLE_GENERATIVE_AI_API_KEY=ai_api_key
