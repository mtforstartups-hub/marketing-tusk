# ---------------------------------------------------------------
# .env.test.example — copy to .env.test and fill in real values.
# .env.test is gitignored and must never be committed.
# ---------------------------------------------------------------

# Cloudflare Turnstile always-passing test keys
# https://developers.cloudflare.com/turnstile/reference/testing/
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
TURNSTILE_HOSTNAMES=localhost

# Google OAuth2 (same credentials your app already uses)
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# Nodemailer / Gmail OAuth2
EMAIL_USER=
ADMIN_EMAIL=

# A DEDICATED test-only Google Sheet (never use the production sheet).
# Share it with EMAIL_USER so the OAuth account can write rows.
# Get the ID from the sheet URL: /spreadsheets/d/<THIS_PART>/edit
TEST_SPREADSHEET_ID=

# Playwright hits this URL (bun dev starts automatically)
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Path to the page containing the contact form
CONTACT_PAGE_PATH=/contact

# Sanity (dummy values to prevent compilation crash during e2e tests)
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_PROJECT_ID=dummy-project-id
